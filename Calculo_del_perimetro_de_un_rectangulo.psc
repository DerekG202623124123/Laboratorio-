Algoritmo Calculo_del_perimetro_de_un_rectangulo
	Definir a, b, c, d, multiplicacion como real 
	Definir Base, Altura, Area, Perimetro como real
	Escribir "Introducir valores de Base...."
	Leer Base
	Escribir "Introducir valores de Altura....."
	Leer Altura
	Area =  Base*Altura
	Escribir "El valor de Area.... ",Area , "m"
	Perimetro = 2*(Base*Altura)
	Escribir "El valor de Perimetro es....",Perimetro , "m"
FinAlgoritmo
